# ==========================================
# MAINTAINIT BACKEND CONFIGURATION
# Copy this file to .env and provide your values.
# Never commit your actual .env file.
# ==========================================

# Application
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintainit
DB_USER=maintainit_user
DB_PASSWORD=replace-with-a-strong-password

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Africa's Talking SMS
AT_USERNAME=sandbox
AT_API_KEY=

# Resend email
RESEND_API_KEY=
EMAIL_FROM=

# Safaricom Daraja / M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# WhatsApp is deferred and is not part of the current setup.